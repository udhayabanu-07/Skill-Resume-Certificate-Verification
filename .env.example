# ==============================================================
# Skill Resume Certificate Verification System - Environment Configuration
# Copy this file to .env and customize values for your local environment
# ==============================================================

# Flask Settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace_with_a_secure_random_secret_key_in_production

# Database Configuration (MySQL via PyMySQL)
# Set USE_SQLITE=True if you want to test without a running MySQL instance
USE_SQLITE=False

DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=skill_verify_db

# Or provide a direct SQLAlchemy URI (Overrides individual DB_* settings)
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/skill_verify_db

# File Upload Configuration
MAX_CONTENT_LENGTH=16777216  # 16 MB in bytes

# Admin Seed Settings (Optional, used during 'flask create-admin')
INITIAL_ADMIN_EMAIL=admin@skillverify.com
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace_with_a_secure_initial_admin_password
