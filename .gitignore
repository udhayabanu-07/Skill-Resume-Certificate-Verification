# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables
.env
.env.local

# SQLite Database local fallbacks
*.db
*.sqlite
*.sqlite3
instance/

# Uploaded User Files (resumes, certificates, profile photos)
app/uploads/resumes/*
!app/uploads/resumes/.gitkeep
app/uploads/certificates/*
!app/uploads/certificates/.gitkeep
app/uploads/profiles/*
!app/uploads/profiles/.gitkeep

# IDEs and Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store

# Logs
*.log
